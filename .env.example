# Jeton partagé entre n8n et le worker (choisissez une longue chaîne aléatoire)
WORKER_TOKEN=change-moi

# App TikTok for Developers (produits « Login Kit » + « Content Posting API », scope video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Doit être enregistrée à l'identique dans l'app TikTok (HTTPS exigé hors localhost)
TIKTOK_REDIRECT_URI=https://votre-domaine.example/tiktok/callback

# Optionnel : uniquement pour le mode « highlights » avec selector=llm
ANTHROPIC_API_KEY=
